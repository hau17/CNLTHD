# Sao chép thành .env, điền giá trị thật rồi chạy: node --env-file=.env src/server.js
# KHÔNG commit file .env.
NODE_ENV=development
PORT=3000

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Quá thời gian này mà Redis không phản hồi thì API trả 503
REDIS_COMMAND_TIMEOUT_MS=5000

# Thư mục lưu trữ (tương đối so với thư mục gốc dự án)
UPLOAD_DIR=uploads
OUTPUT_DIR=output
ZIP_DIR=zips

# Giới hạn upload
MAX_FILES=50
MAX_FILE_SIZE_MB=20

# Bảo mật
# Danh sách origin được gọi API, phân tách bằng dấu phẩy. Để trống = chỉ same-origin.
CORS_ORIGINS=
# Số reverse proxy đứng trước server (0 nếu chạy trực tiếp)
TRUST_PROXY=0
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW_MIN=15
API_RATE_LIMIT_PER_MIN=120

# Worker
WORKER_CONCURRENCY=4
